---
import Layout from '../layouts/Layout.astro';
import { existsSync } from 'fs';
import { join } from 'path';

// Check if resume.pdf exists
const resumePath = join(process.cwd(), 'public/resume.pdf');
const hasResume = existsSync(resumePath);

// Date of the latest resume content edit. Update alongside the PDF.
const resumeLastEdited = '2026-10-20';
const resumeLastEditedLabel = new Date(`${resumeLastEdited}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Layout title="Resume - Avi Zurlo">
  <div style="margin-bottom: 32px;">
    <h1 style="font-size: 14px; font-weight: 400; color: var(--text-tertiary); margin: 0; text-transform: uppercase; letter-spacing: 0.1em;">Resume</h1>
    {hasResume && (
      <div style="display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 24px; margin-top: 12px; font-size: 13px;">
        <p style="color: var(--text-tertiary); margin: 0;">
          Last updated: <time datetime={resumeLastEdited}>{resumeLastEditedLabel}</time>
        </p>
        <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">Open PDF ↗</a>
      </div>
    )}
  </div>

  {hasResume ? (
    <div style="border: 1px solid var(--border-secondary); overflow: hidden;">
      <iframe
        src="/resume.pdf#zoom=75"
        class="resume-iframe"
        title="Resume PDF"
      />
    </div>
  ) : (
    <div style="padding: 64px 0;">
      <p style="color: var(--text-quaternary); margin-bottom: 16px;">
        No resume uploaded yet.
      </p>
      <p style="font-size: 13px; color: var(--text-quaternary);">
        Add your resume.pdf to the public/ folder
      </p>
    </div>
  )}

  <style>
    .resume-iframe {
      width: 100%;
      height: 600px;
      border: none;
    }

    @media (min-width: 640px) {
      .resume-iframe {
        height: 800px;
      }
    }
  </style>
</Layout>
