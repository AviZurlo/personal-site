---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

// Get about content from collection
const aboutEntry = await getEntry('about', 'index');
const { Content } = await aboutEntry.render();
---

<Layout title="About - Avi Zurlo">

  <div class="prose about-content">
    <Content />
  </div>

  <style>
    .about-content :first-child {
      margin-top: 0;
    }

    .about-content :global(h2) {
      font-size: 14px;
      font-weight: 400;
      color: var(--text-tertiary);
      margin-bottom: 32px;
      margin-top: 48px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .about-content :global(h2:first-of-type) {
      margin-top: 0;
    }

    @media (min-width: 640px) {
      .about-content :global(h2) {
        margin-top: 80px;
      }

      .about-content :global(h2:first-of-type) {
        margin-top: 0;
      }
    }

  </style>
</Layout>
